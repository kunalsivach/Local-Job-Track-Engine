# Multi-Key Multi-Provider LLM Failover Pool
# You can supply multiple keys separated by commas.
# If one key hits quota or rate limits, the engine automatically fails over to the next key.

# Gemini API Keys (comma-separated)
GEMINI_API_KEYS="MY_GEMINI_API_KEY_1,MY_GEMINI_API_KEY_2"

# Groq API Keys (optional, fast inference fallback)
GROQ_API_KEYS="gsk_your_groq_key_1"

# OpenAI API Keys (optional fallback)
OPENAI_API_KEYS="sk-your_openai_key_1"

# Local Ollama URL (offline fallback)
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"

# Chrome Remote Debugging Port (defaults to 9222)
CHROME_CDP_URL="http://localhost:9222"

PORT=3000
